---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const objects = await getCollection('objects', ({ data }) => !data.draft);
const notes = objects
  .filter((o) => o.data.type === 'note')
  .sort((a, b) => +b.data.date - +a.data.date);

const fmt = (d: Date) =>
  `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`;
---

<Base title="Journal — Sekiya" description="Transmissions from Sekiya: notes, updates and open questions." objectCount={objects.length}>
  <header class="page-head shell">
    <p class="kicker">Journal</p>
    <h1>Transmissions.</h1>
    <p class="page-sub">
      Notes from the institute — published when there is something to publish, not on a schedule,
      and while a question is still open if that is where it honestly stands.
    </p>
  </header>

  <section class="section shell" style="padding-top: 0;">
    <ul class="journal-list">
      {
        notes.map((note) => (
          <li class="reveal">
            <span class="j-date">{fmt(note.data.date)}</span>
            <span class="j-title">
              <a href={`/n/${note.id}/`}>{note.data.title}</a>
            </span>
            <span class="j-line">{note.data.summary}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
