---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RegisterTable from '../../components/RegisterTable.astro';
import { AREA_LABEL } from '../../content.config';

export async function getStaticPaths() {
  const questions = await getCollection('questions');
  const objects = await getCollection('objects', ({ data }) => !data.draft);
  return questions.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, objects },
  }));
}

const { entry, objects } = Astro.props;
const { Content } = await render(entry);

const linked = (entry.data.objects ?? [])
  .map((id) => objects.find((o) => o.id === id))
  .filter(Boolean) as typeof objects;
---

<Base title={`${entry.data.question} — Sekiya`} description={entry.data.lead} objectCount={objects.length}>
  <header class="question-hero shell">
    <p class="kicker">A Sekiya question · {entry.data.areas.map((a) => AREA_LABEL[a]).join(' · ')}</p>
    <h1>{entry.data.question}</h1>
  </header>

  <div class="question-body shell">
    <Content />
  </div>

  {
    linked.length > 0 && (
      <section class="section shell" aria-label="Objects bearing on this question">
        <p class="kicker">Objects bearing on it</p>
        <RegisterTable entries={linked} caption={false} />
      </section>
    )
  }

  {
    (entry.data.repos ?? []).length > 0 && (
      <section class="section shell" aria-label="Public repositories">
        <p class="kicker">Public repositories</p>
        <ul class="journal-list">
          {entry.data.repos!.map((repo) => (
            <li>
              <span class="j-date mono">repo ↗</span>
              <span class="j-title">
                <a href={repo.url} target="_blank" rel="noreferrer">{repo.label}</a>
              </span>
              {repo.note && <span class="j-line">{repo.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="shell" style="padding-bottom: var(--section-y);">
    <a class="text-link" href="/">← All questions</a>
  </div>
</Base>
