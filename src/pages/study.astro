---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const objects = await getCollection('objects', ({ data }) => !data.draft);
---

<Base title="Study — Sekiya" description="Sekiya's learning surface: notebooks you can play." objectCount={objects.length}>
  <header class="page-head shell">
    <p class="kicker">Study</p>
    <h1>The notebook shelf.</h1>
    <p class="page-sub">
      Study is where Sekiya keeps its beautiful technical notebooks: visual explanations, interactive
      mathematical demonstrations, rebuilds of mechanisms from scratch. Not a curriculum, not a course —
      <em>opened when curiosity strikes</em>.
    </p>
  </header>

  <section class="section shell" style="padding-top: 0;">
    <div class="shelf-note reveal">
      <p>
        <strong>The shelf is being stocked.</strong> Notebooks are recovered and rebuilt from the
        institute's older learning material before new ones are written.
      </p>
      <p>
        The first notebook in preparation takes the field on the front page apart — reaction–diffusion
        from scratch — until you could rebuild it yourself.
      </p>
      <p class="mono mono-dim" style="font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;">
        SK-ST-01 · reaction–diffusion from scratch · in preparation
      </p>
    </div>
  </section>
</Base>
