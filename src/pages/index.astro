---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
---

<Base
  title="Sekiya — empirical agent behavior"
  description="Sekiya studies autonomous-agent behavior empirically and builds technology for understanding difficult systems."
>
  <section class="home-hero" data-home-hero>
    <div class="home-hero__environment" aria-hidden="true">
      <span class="home-hero__plane home-hero__plane--deep"></span>
      <span class="home-hero__plane home-hero__plane--near"></span>
      <svg class="home-hero__field" viewBox="0 0 1440 900" preserveAspectRatio="none"><g class="field-plane field-plane--far"><path d="M-120 622 C170 548 371 573 608 472 S1035 329 1560 248"/><path d="M-80 214 C218 310 403 294 612 210 S1002 120 1490 154"/></g><g class="field-plane field-plane--front"><path d="M-160 676 C188 650 331 437 586 451 C872 467 941 703 1262 622 C1395 589 1486 505 1578 386"/></g></svg>
    </div>
    <div class="shell home-hero__body">
      <div class="home-hero__copy">
        <div class="hero-identity">
          <Mark size={112} variant="hero" decorative={true} />
          <div><p class="hero-identity__name">Sekiya</p><p class="hero-identity__line">Independent research and technology</p></div>
        </div>
        <h1>Behavior is not a label. It is a question.</h1>
        <p class="home-hero__lede">Sekiya studies how autonomous agents behave under controlled variation — individually, socially and institutionally — and builds technology for understanding difficult systems.</p>
        <a class="home-hero__entry" href="/research/">Explore Research <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="ruled-section shell" aria-labelledby="method">
    <div class="section-rail"><p class="eyebrow">Method</p><h2 id="method">Ask the explanation to survive contact with evidence.</h2></div>
    <div class="section-content"><p class="section-intro">Access does not prove comprehension. A false report does not establish deception. Coordinated behavior does not establish collusion. Sekiya uses controlled variation, intervention and replication where justified to distinguish competing explanations.</p></div>
  </section>

  <section class="ruled-section shell home-section--tint" aria-labelledby="programmes">
    <div class="section-rail"><p class="eyebrow">Programmes</p><h2 id="programmes">Research and Technology.</h2></div>
    <div class="section-content home-outro__links">
      <a href="/research/">Research — the current programme and Research Record <span aria-hidden="true">→</span></a>
      <a href="/technology/">Technology — instruments and products, when earned <span aria-hidden="true">→</span></a>
      <a href="/institute/">About Sekiya's boundaries and method <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
