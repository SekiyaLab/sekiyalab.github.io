---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ResearchIndex from '../components/ResearchIndex.astro';
import SignalField from '../components/SignalField.astro';
import { areas, research } from '../data/research';

const questions = (await getCollection('questions')).sort((a, b) => a.data.order - b.data.order);
const countFor = (code: (typeof areas)[number]['code']) => research.filter((item) => item.area === code).length;
---

<Base
  title="Sekiya — systems worth looking at twice"
  description="Sekiya is an independent place for computer science and computational experimentation."
  objectCount={research.length}
>
  <section class="home-hero">
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">Sekiya / independent work</p>
        <h1>Systems get more interesting once they start <em>moving.</em></h1>
        <p class="home-hero__lede">
          Sekiya is a place for computer science and computational experimentation: models,
          instruments, simulations, and the occasional thing that is difficult to classify.
        </p>
        <p class="home-hero__aside">Mostly, it is a way of finding things out.</p>
        <div class="home-hero__actions">
          <a class="button button--bright" href="#work">Explore the work <span aria-hidden="true">↓</span></a>
          <a class="button button--quiet" href="/institute/">About Sekiya <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <SignalField />
    </div>
  </section>

  <section class="home-section shell" id="areas" aria-labelledby="areas-heading">
    <div class="section-heading">
      <p class="eyebrow">Ways in</p>
      <h2 id="areas-heading">Four ways in. No departments.</h2>
      <p>Loose directions for work that tends to find its own route.</p>
    </div>

    <div class="area-grid">
      {areas.map((area) => (
        <article class:list={['area-card', `area-card--${area.code}`]}>
          <div class="area-card__top">
            <span>{area.short}</span>
            <span>{countFor(area.code)} named</span>
          </div>
          <h3>{area.label}</h3>
          <p>{area.description}</p>
          <a href="#work" data-area-link={area.code}>See the work <span aria-hidden="true">↓</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section home-section--tint" id="questions" aria-labelledby="questions-heading">
    <div class="shell question-section">
      <div class="section-heading">
        <p class="eyebrow">Questions</p>
        <h2 id="questions-heading">A few questions worth keeping open.</h2>
      </div>
      <ol class="question-strip">
        {questions.map((question, index) => (
          <li>
            <a href={`/q/${question.id}/`}>
              <span class="question-strip__number">{String(index + 1).padStart(2, '0')}</span>
              <span>{question.data.question}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home-section shell" id="work" aria-label="Research index">
    <ResearchIndex />
  </section>

  <section class="home-section shell home-outro" aria-label="Explore Sekiya">
    <p class="eyebrow">Elsewhere in Sekiya</p>
    <div>
      <h2>More to pull apart.</h2>
      <p>There are notebooks, field notes, and the full public record—when you feel like following a thread.</p>
    </div>
    <div class="home-outro__links">
      <a href="/study/">The notebook shelf <span aria-hidden="true">→</span></a>
      <a href="/journal/">Notes &amp; transmissions <span aria-hidden="true">→</span></a>
      <a href="https://github.com/SekiyaLab" target="_blank" rel="noreferrer">SekiyaLab on GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>

<script>
  const bootAreaLinks = () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-area-link]').forEach((link) => {
      if (link.dataset.ready) return;
      link.dataset.ready = 'true';
      link.addEventListener('click', () => {
        const target = link.dataset.areaLink;
        const button = document.querySelector<HTMLButtonElement>(`[data-research-filter="${target}"]`);
        button?.click();
      });
    });
  };

  bootAreaLinks();
  document.addEventListener('astro:page-load', bootAreaLinks);
</script>
