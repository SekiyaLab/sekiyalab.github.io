import Base from '../layouts/Base.astro';
import ResearchIndex from '../components/ResearchIndex.astro';
---
<Base title="Research — Sekiya" description="Sekiya's agent-behavior programme and preserved Research Record.">
  <header class="page-head shell"><p class="kicker">Research</p><h1>Autonomous agents, studied as behavioral entities.</h1><p class="page-sub">The current programme studies behavior under controlled variation. It has not yet established agent-behavior findings or selected its first experiment.</p></header>
  <section class="section shell"><div class="institute-grid"><div><h3>What is established</h3><p>Research is directed at individual, social and institutional agent behavior, including capability evolution.</p></div><div><h3>What is required</h3><p>Bounded, reproducible claims; discriminating interventions; and replication where the claim requires it.</p></div><div><h3>What remains open</h3><p>The full programme architecture, measurements, experiment families and first study remain a later decision.</p></div></div></section>
  <section class="ruled-section shell" aria-label="Research Record"><ResearchIndex /></section>
</Base>
