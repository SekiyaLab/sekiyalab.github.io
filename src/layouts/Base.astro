---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/night.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  objectCount?: number;
}

const {
  title,
  description = 'Sekiya is an independent place for computer science and computational experimentation.',
  objectCount = 0,
} = Astro.props;

const path = Astro.url.pathname;
const build = import.meta.env.GITHUB_SHA?.slice(0, 7) ?? 'dev';
const year = new Date().getUTCFullYear();

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#030303" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sekiya" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://sekiyalab.github.io/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/newsreader-display-300.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-text-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body data-objects={objectCount}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header shell">
      <div class="status-line">
        <a class="wordmark" href="/">Sekiya</a>
        <span class="status-place mono mono-dim" aria-hidden="true">Systems, models, computation</span>
        <nav class="site-nav" aria-label="Primary">
          {
            [
              { href: '/#work', label: 'Work' },
              { href: '/#questions', label: 'Questions' },
              { href: '/academy/', label: 'Academy' },
              { href: '/institute/', label: 'About' },
            ].map((item) => (
              <a
                href={item.href}
                aria-current={
                  item.href === '/'
                    ? path === '/'
                      ? 'page'
                      : undefined
                    : path.startsWith(item.href)
                      ? 'page'
                      : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-creed">Built to be looked at closely.</p>
      <div class="footer-grid">
        <a href="https://github.com/SekiyaLab" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="https://www.npmjs.com/package/trace-npm" target="_blank" rel="noreferrer">trace-npm on npm ↗</a>
        <a href="https://joshuadefreitas.github.io" target="_blank" rel="noreferrer">Joshua de Freitas ↗</a>
        <span class="spacer"></span>
        <span>© {year} Sekiya</span>
      </div>
      <p class="colophon" data-colophon>
        build {build} · set in Newsreader &amp; DM Mono
      </p>
    </footer>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
