---
import { areas, research } from '../data/research';
import ProjectGlyph from './ProjectGlyph.astro';

const counts = Object.fromEntries(
  areas.map((area) => [area.code, research.filter((item) => item.area === area.code).length]),
);
---

<div class="section-rail">
  <p class="eyebrow">The work</p>
  <h2>Named here. Linked when the signal is public.</h2>
  <p class="section-intro">Some work is still private. It belongs in the index anyway.</p>
  <div class="research-index__filters" role="group" aria-label="Filter work by area">
    <button class="research-filter" type="button" data-research-filter="all" aria-pressed="true">All <span>{research.length}</span></button>
    {areas.map((area) => (
      <button class="research-filter" type="button" data-research-filter={area.code} aria-pressed="false">
        {area.label} <span>{counts[area.code]}</span>
      </button>
    ))}
  </div>
  <span class="research-index__count" data-research-count aria-live="polite">{research.length} entries</span>
</div>

<div class="section-content" data-research-index>
  <ol class="work-ledger">
    {research.map((item, index) => (
      <li class:list={['work-row', `work-row--${item.area}`, `work-row--${item.signature}`]} data-work-area={item.area}>
        <span class="work-row__number">{String(index + 1).padStart(2, '0')}</span>
        <div class="work-row__visual">
          <ProjectGlyph signature={item.signature} title={item.title} />
        </div>
        <div class="work-row__body">
          <div class="work-row__meta">
            <span>{item.kind}</span>
            <span class:list={[
              'access-tag',
              item.access === 'Public' ? 'is-public' : item.access === 'Private' ? 'is-private' : 'is-open',
            ]}>
              {item.access}
            </span>
            {item.flagged && <span class="flag-tag" title="A genuine flagged finding">Flagged</span>}
          </div>
          <h3>
            {item.href ? (
              item.href.startsWith('/') ? (
                <a href={item.href}>{item.title}<span aria-hidden="true"> →</span></a>
              ) : (
                <a href={item.href} target="_blank" rel="noreferrer">{item.title}<span aria-hidden="true"> ↗</span></a>
              )
            ) : item.title}
          </h3>
          <p>{item.summary}</p>
        </div>
      </li>
    ))}
  </ol>
</div>

<script>
  const bootResearchIndex = () => {
    const root = document.querySelector<HTMLElement>('[data-research-index]:not([data-ready])');
    if (!root) return;
    root.dataset.ready = 'true';

    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-research-filter]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-work-area]'));
    const count = document.querySelector<HTMLElement>('[data-research-count]');

    const apply = (area: string) => {
      let visible = 0;
      cards.forEach((card) => {
        const show = area === 'all' || card.dataset.workArea === area;
        card.hidden = !show;
        if (show) visible += 1;
      });
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.researchFilter === area));
      });
      if (count) count.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}`;
    };

    buttons.forEach((button) => button.addEventListener('click', () => apply(button.dataset.researchFilter ?? 'all')));
  };

  bootResearchIndex();
  document.addEventListener('astro:page-load', bootResearchIndex);
</script>
