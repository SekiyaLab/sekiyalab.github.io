---
interface Numeral {
  value: string;
  label: string;
  accent?: boolean;
}
interface Props {
  items: Numeral[];
}
const { items } = Astro.props;
---

<div class="numerals" role="group" aria-label={items.map((i) => `${i.value} ${i.label}`).join(', ')}>
  {
    items.map((item) => (
      <div class:list={['num', item.accent && 'accent']}>
        <div class="n-value">{item.value}</div>
        <div class="n-label">{item.label}</div>
      </div>
    ))
  }
</div>
