---
/* R-002 — the same evidence source, two answers.
 * One lane per retrieval path; tick marks are records. Designed SVG.
 */
---

<svg viewBox="0 0 720 240" role="img" aria-label="Two views of the same audit log. The canonical query lane is empty: zero matches, exit status zero. The raw log lane holds 192 records.">
  <defs>
    <pattern id="tickrow" width="3.4" height="10" patternUnits="userSpaceOnUse">
      <rect x="0" y="0" width="1" height="10" fill="var(--ink-3)" opacity="0.85" />
    </pattern>
  </defs>

  <!-- lane: canonical query -->
  <text x="40" y="52" fill="var(--ink-3)" font-size="9.5" letter-spacing="1.8" font-family="var(--mono)">AUSEARCH -K SPECIMEN</text>
  <line x1="40" y1="78" x2="680" y2="78" stroke="var(--hair-2)" stroke-width="1" />
  <text x="40" y="108" fill="var(--ink-4)" font-size="11" font-family="var(--mono)">no matches</text>
  <text x="680" y="108" fill="var(--ink-4)" font-size="11" font-family="var(--mono)" text-anchor="end">exit 0</text>

  <!-- lane: raw log -->
  <text x="40" y="162" fill="var(--ink-3)" font-size="9.5" letter-spacing="1.8" font-family="var(--mono)">/VAR/LOG/AUDIT/AUDIT.LOG</text>
  <line x1="40" y1="188" x2="680" y2="188" stroke="var(--hair-2)" stroke-width="1" />
  <rect x="40" y="178" width="652.8" height="10" fill="url(#tickrow)" />
  <text x="680" y="218" fill="var(--amber)" font-size="11" font-family="var(--mono)" text-anchor="end">192 records · same host · same moment</text>

  <!-- connector -->
  <line x1="360" y1="80" x2="360" y2="176" stroke="var(--amber-dim)" stroke-width="1" stroke-dasharray="2 4" />
  <text x="372" y="132" fill="var(--ink-3)" font-size="9.5" letter-spacing="1.4" font-family="var(--mono)">SAME EVIDENCE SOURCE</text>
</svg>
