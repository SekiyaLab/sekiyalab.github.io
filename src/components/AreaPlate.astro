---
/* Four areas, four different static visual languages — generated once at
   build time from small deterministic functions, not four skins on one
   template. Real computation; the output is a still, art-directed figure,
   never a live simulation. */

interface Props {
  area: 'M&S' | 'S&S' | 'AGT' | 'CMP';
}

const { area } = Astro.props;

/* mulberry32 — tiny deterministic PRNG so rebuilds are stable */
function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const W = 640, H = 420;

function ridgeline() {
  /* M&S — a joyplot of overlapping density curves; the front curve is amber */
  const rnd = mulberry32(9001);
  const rows = 6;
  const paths: { d: string; amber: boolean }[] = [];
  for (let r = 0; r < rows; r++) {
    const baseY = 60 + r * 56;
    const mu = 0.28 + rnd() * 0.44;
    const sigma = 0.09 + rnd() * 0.1;
    const amp = 96 + rnd() * 40;
    const pts: [number, number][] = [];
    for (let i = 0; i <= 64; i++) {
      const x = i / 64;
      const g = Math.exp(-((x - mu) ** 2) / (2 * sigma * sigma));
      const wobble = Math.sin(x * 30 + r) * 2.2 * (1 - g);
      const y = baseY - g * amp - wobble;
      pts.push([40 + x * (W - 80), y]);
    }
    let d = `M${pts[0][0].toFixed(1)},${(baseY + 10).toFixed(1)} `;
    d += pts.map(([x, y]) => `L${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
    d += ` L${pts[pts.length - 1][0].toFixed(1)},${(baseY + 10).toFixed(1)} Z`;
    paths.push({ d, amber: r === rows - 1 });
  }
  return paths;
}

function traceGraph() {
  /* S&S — an event trace: nodes on a timeline, one lineage picked out */
  const rnd = mulberry32(2002);
  const n = 11;
  const nodes = Array.from({ length: n }, (_, i) => ({
    x: 46 + (i / (n - 1)) * (W - 92),
    y: 130 + Math.sin(i * 1.7 + 0.6) * 90 + (rnd() - 0.5) * 30,
  }));
  const edges: { a: number; b: number; live: boolean }[] = [];
  for (let i = 0; i < n - 1; i++) edges.push({ a: i, b: i + 1, live: false });
  /* a secondary lineage that skips around — the "trace" */
  const lineage = [0, 2, 3, 6, 7, 9, 10];
  for (let i = 0; i < lineage.length - 1; i++) edges.push({ a: lineage[i], b: lineage[i + 1], live: true });
  return { nodes, edges };
}

function vectorField() {
  /* CMP — a small deterministic flow field (a saddle), drawn as static
     hairline streaks. Same spirit as a live reaction–diffusion field —
     computed, not decorative — without asking a browser for a GPU. */
  const cols = 14, rows = 9;
  const segs: { x1: number; y1: number; x2: number; y2: number }[] = [];
  for (let j = 0; j < rows; j++) {
    for (let i = 0; i < cols; i++) {
      const x = 34 + (i / (cols - 1)) * (W - 68);
      const y = 40 + (j / (rows - 1)) * (H - 80);
      const nx = (x - W / 2) / (W / 2);
      const ny = (y - H / 2) / (H / 2);
      const vx = nx - ny * 0.6;
      const vy = -ny - nx * 0.6;
      const len = Math.hypot(vx, vy) || 1;
      const s = 13;
      segs.push({ x1: x, y1: y, x2: x + (vx / len) * s, y2: y + (vy / len) * s });
    }
  }
  return segs;
}

const ridge = area === 'M&S' ? ridgeline() : null;
const graph = area === 'S&S' ? traceGraph() : null;
const field = area === 'CMP' ? vectorField() : null;
---

<div class="area-plate-art" data-area={area}>
  {ridge && (
    <svg viewBox={`0 0 ${W} ${H}`} role="presentation" aria-hidden="true">
      {ridge.map((row) => (
        <path d={row.d} class={row.amber ? 'ap-fill-amber' : 'ap-fill'} />
      ))}
    </svg>
  )}
  {graph && (
    <svg viewBox={`0 0 ${W} ${H}`} role="presentation" aria-hidden="true">
      {graph.edges.map((e) => (
        <line
          x1={graph.nodes[e.a].x} y1={graph.nodes[e.a].y}
          x2={graph.nodes[e.b].x} y2={graph.nodes[e.b].y}
          class={e.live ? 'ap-line-amber' : 'ap-line'}
        />
      ))}
      {graph.nodes.map((p, i) => (
        <circle cx={p.x} cy={p.y} r={i === 0 || i === graph.nodes.length - 1 ? 4.5 : 3} class="ap-node" />
      ))}
    </svg>
  )}
  {field && (
    <svg viewBox={`0 0 ${W} ${H}`} role="presentation" aria-hidden="true">
      {field.map((s) => <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} class="ap-line" />)}
    </svg>
  )}
  {area === 'AGT' && (
    <svg viewBox={`0 0 ${W} ${H}`} role="presentation" aria-hidden="true">
      <line x1="40" y1={H / 2} x2={W - 40} y2={H / 2} class="ap-line-dash" />
      <circle cx={W / 2} cy={H / 2} r="4" class="ap-node-open" />
      <text x={W / 2} y={H / 2 - 22} text-anchor="middle" class="ap-empty-label">nothing filed yet</text>
    </svg>
  )}
</div>

<style>
  .area-plate-art {
    aspect-ratio: 640 / 420;
    background: var(--raised);
  }
  .area-plate-art svg { width: 100%; height: 100%; display: block; }
  .ap-fill { fill: var(--hair-3); }
  .ap-fill-amber { fill: var(--amber-hair); }
  .ap-line { stroke: var(--ink-4); stroke-width: 1; }
  .ap-line-amber { stroke: var(--amber-dim); stroke-width: 1.2; }
  .ap-line-dash { stroke: var(--ink-4); stroke-width: 1; stroke-dasharray: 2 6; }
  .ap-node { fill: var(--void); stroke: var(--ink-3); stroke-width: 1; }
  .ap-node-open { fill: none; stroke: var(--amber-dim); stroke-width: 1.2; }
  .ap-empty-label {
    fill: var(--ink-4);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
