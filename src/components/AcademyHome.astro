---
import Base from '../layouts/Base.astro';
---

<Base
  title="Academy — Sekiya"
  description="A set of visual technical notebooks: open a mechanism and take it apart."
  objectCount={2}
>
  <header class="academy-hero">
    <div class="shell academy-hero__copy">
      <p class="eyebrow">Sekiya Academy</p>
      <h1>Open a mechanism. <em>Trace it until it is plain.</em></h1>
      <p>
        A small set of visual technical rooms. Each one starts with a working mechanism,
        lets you change its state, then names the boundary of what the room does not prove.
      </p>
    </div>
  </header>

  <section class="ruled-section shell academy-room" aria-labelledby="open-rooms">
    <div class="section-rail">
      <p class="eyebrow">Open rooms</p>
      <h2 id="open-rooms">A path through the machine.</h2>
      <p class="section-intro">Start with command execution, then the state pattern that keeps a simulation coherent.</p>
    </div>
    <div class="section-content">
      <div class="academy-sequence">
        <a class="academy-room-link academy-room-link--gpu" href="/academy/gpu-command-journey/">
          <span class="academy-room-link__no">01</span>
          <span class="academy-room-link__visual" aria-hidden="true">
            <span class="notebook__chip">
              {Array.from({ length: 35 }, (_, i) => <i style={`--i:${i}`}></i>)}
            </span>
            <span class="notebook__beam"></span>
          </span>
          <span class="notebook__meta">GPU / trace / interactive</span>
          <h3>One command's journey through the GPU</h3>
          <p>Buffers, binding, encoding, dispatch, and why the CPU cannot simply reach in.</p>
          <span class="notebook__enter">Enter room <b aria-hidden="true">↗</b></span>
        </a>

        <a class="academy-room-link academy-room-link--ping" href="/academy/ping-pong-buffers/">
          <span class="academy-room-link__no">02</span>
          <span class="academy-room-link__visual" aria-hidden="true">
            <span class="notebook__buffer">A</span>
            <span></span>
            <span class="notebook__buffer">B</span>
          </span>
          <span class="notebook__meta">Simulation / visual / from scratch</span>
          <h3>Why simulations need two futures</h3>
          <p>Read here, write there, swap the names. One tiny pattern prevents a world from tearing itself apart.</p>
          <span class="notebook__enter">Enter room <b aria-hidden="true">↗</b></span>
        </a>
      </div>
    </div>
  </section>

  <section class="ruled-section shell academy-cabinet">
    <div class="section-rail">
      <p class="eyebrow">Boundary</p>
      <h2>Not every note is a room.</h2>
      <p class="section-intro academy-cabinet__lede">
        The Academy only links material that has an explanation, a working interaction,
        and a stated limit.
      </p>
    </div>
    <div class="section-content">
      <p class="academy-recovered">
        Implementation notes that are not yet explainable as a room stay unpublished here.
        That keeps the index honest: an item appears when someone can enter it, test the
        central mechanism, and see where the explanation stops.
      </p>
    </div>
  </section>

  <section class="academy-principle shell">
    <p class="eyebrow">The rule</p>
    <blockquote>
      If the central idea cannot be explained clearly, we probably do not understand it yet.
    </blockquote>
  </section>
</Base>
