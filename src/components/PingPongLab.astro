<div class="ping-lab" data-ping-lab>
  <div class="ping-lab__board is-read" data-board="a">
    <span>A / PRESENT / READ</span>
    <div class="ping-lab__cells">
      {Array.from({ length: 48 }, (_, i) => <i class:list={{ alive: [4, 13, 14, 20, 22, 29, 37, 38, 39].includes(i) }}></i>)}
    </div>
  </div>
  <div class="ping-lab__flow" aria-hidden="true"><i></i><strong>tick 0</strong></div>
  <div class="ping-lab__board is-write" data-board="b">
    <span>B / FUTURE / WRITE</span>
    <div class="ping-lab__cells">
      {Array.from({ length: 48 }, (_, i) => <i class:list={{ alive: [5, 12, 14, 21, 22, 30, 36, 38, 46].includes(i) }}></i>)}
    </div>
  </div>
  <button type="button" data-ping-swap>Run tick / swap roles</button>
</div>

<script>
  const bootPingLab = () => {
    const root = document.querySelector<HTMLElement>('[data-ping-lab]:not([data-ready])');
    if (!root) return;
    root.dataset.ready = 'true';
    const button = root.querySelector<HTMLButtonElement>('[data-ping-swap]');
    const boards = Array.from(root.querySelectorAll<HTMLElement>('[data-board]'));
    const label = root.querySelector<HTMLElement>('.ping-lab__flow strong');
    let tick = 0;
    button?.addEventListener('click', () => {
      tick += 1;
      boards.forEach((board) => {
        board.classList.toggle('is-read');
        board.classList.toggle('is-write');
        const role = board.classList.contains('is-read') ? 'PRESENT / READ' : 'FUTURE / WRITE';
        const name = board.dataset.board?.toUpperCase();
        const heading = board.querySelector('span');
        if (heading) heading.textContent = `${name} / ${role}`;
      });
      if (label) label.textContent = `tick ${tick}`;
    });
  };
  bootPingLab();
  document.addEventListener('astro:page-load', bootPingLab);
</script>
