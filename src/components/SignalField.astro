<div class="signal-field" data-signal-field aria-hidden="true">
  <svg class="signal-field__static" viewBox="0 0 1200 760" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <radialGradient id="signal-static-glow" cx="68%" cy="42%" r="62%">
        <stop offset="0%" stop-color="rgba(125, 192, 238, .11)" />
        <stop offset="42%" stop-color="rgba(125, 192, 238, .035)" />
        <stop offset="100%" stop-color="rgba(125, 192, 238, 0)" />
      </radialGradient>
    </defs>
    <rect width="1200" height="760" fill="url(#signal-static-glow)" />
    <g class="signal-field__static-lines">
      <path d="M146 148L310 220L478 165L680 238L900 182L1072 250" />
      <path d="M102 394L270 336L426 428L612 352L790 436L1058 358" />
      <path d="M188 594L360 506L550 578L728 492L938 566L1116 500" />
      <path d="M310 220L270 336L360 506M478 165L426 428L550 578M680 238L612 352L728 492M900 182L790 436L938 566" />
    </g>
    <g class="signal-field__static-points">
      <circle cx="146" cy="148" r="2" /><circle cx="310" cy="220" r="1.4" /><circle cx="478" cy="165" r="1.4" />
      <circle cx="680" cy="238" r="2.2" /><circle cx="900" cy="182" r="1.4" /><circle cx="1072" cy="250" r="1.4" />
      <circle cx="102" cy="394" r="1.4" /><circle cx="270" cy="336" r="1.4" /><circle cx="426" cy="428" r="2" />
      <circle cx="612" cy="352" r="1.4" /><circle cx="790" cy="436" r="1.4" /><circle cx="1058" cy="358" r="2" />
      <circle cx="188" cy="594" r="1.4" /><circle cx="360" cy="506" r="2" /><circle cx="550" cy="578" r="1.4" />
      <circle cx="728" cy="492" r="1.4" /><circle cx="938" cy="566" r="2" /><circle cx="1116" cy="500" r="1.4" />
    </g>
  </svg>
  <canvas></canvas>
  <div class="signal-field__bloom"></div>
  <div class="signal-field__axis signal-field__axis--x"></div>
  <div class="signal-field__axis signal-field__axis--y"></div>
</div>

<script>
  type Point = { x: number; y: number; phase: number; speed: number; layer: number };

  const bootSignalField = () => {
    const root = document.querySelector<HTMLElement>('[data-signal-field]:not([data-ready])');
    if (!root) return;
    root.dataset.ready = 'true';

    const canvas = root.querySelector('canvas');
    const context = canvas?.getContext('2d');
    if (!canvas || !context) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const points: Point[] = Array.from({ length: 78 }, (_, index) => ({
      x: ((index * 47) % 101) / 101,
      y: ((index * 67) % 97) / 97,
      phase: index * 0.618,
      speed: 0.34 + ((index * 13) % 9) / 13,
      layer: index % 3,
    }));
    const pointer = { x: 0.52, y: 0.48, active: false };
    const scroll = { value: 0 };
    let frame = 0;
    let width = 0;
    let height = 0;
    let ratio = 1;

    const resize = () => {
      const box = root.getBoundingClientRect();
      ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, Math.floor(box.width));
      height = Math.max(1, Math.floor(box.height));
      canvas.width = Math.floor(width * ratio);
      canvas.height = Math.floor(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
    };

    const coordinates = (point: Point, time: number) => {
      const amplitude = 0.012 + point.layer * 0.009;
      const drift = reduced.matches ? 0 : Math.sin(time * point.speed + point.phase) * amplitude;
      const px = pointer.x - point.x;
      const py = pointer.y - point.y;
      const pd = Math.max(.05, Math.hypot(px, py));
      const pull = pointer.active && pd < .34 ? (0.34 - pd) * .11 : 0;
      return {
        x: Math.max(-0.02, Math.min(1.02, point.x + drift + (px / pd) * pull + scroll.value * (point.layer - 1) * .02)) * width,
        y: Math.max(-0.02, Math.min(1.02, point.y + Math.cos(time * point.speed * .71 + point.phase) * amplitude + (py / pd) * pull)) * height,
      };
    };

    const draw = (now = 0) => {
      const time = now / 2400;
      context.clearRect(0, 0, width, height);
      context.fillStyle = '#0a0b0d';
      context.fillRect(0, 0, width, height);

      /* one quiet light, barely tinted icy — the only place colour is
         literal in this field, and only ever this faint */
      const glow = context.createRadialGradient(
        (pointer.active ? pointer.x : .69) * width,
        (pointer.active ? pointer.y : .43) * height,
        0,
        (pointer.active ? pointer.x : .69) * width,
        (pointer.active ? pointer.y : .43) * height,
        Math.max(width, height) * .68,
      );
      glow.addColorStop(0, `rgba(125, 192, 238, ${pointer.active ? .05 : .028})`);
      glow.addColorStop(1, 'rgba(0, 0, 0, 0)');
      context.fillStyle = glow;
      context.fillRect(0, 0, width, height);

      /* a quiet silver mesh — proximity only, no bright colour */
      const mapped = points.map((point) => coordinates(point, time));
      for (let left = 0; left < mapped.length; left += 1) {
        for (let right = left + 1; right < mapped.length; right += 1) {
          const a = mapped[left];
          const b = mapped[right];
          const distance = Math.hypot(a.x - b.x, a.y - b.y);
          const threshold = Math.min(width, height) * (points[left].layer === points[right].layer ? .16 : .1);
          if (distance > threshold) continue;
          context.beginPath();
          context.moveTo(a.x, a.y);
          context.lineTo(b.x, b.y);
          const alpha = Math.max(.008, .06 - distance / 2600);
          context.strokeStyle = `rgba(167, 172, 180, ${alpha})`;
          context.lineWidth = points[left].layer === 0 ? .5 : .8;
          context.stroke();
        }
      }

      mapped.forEach((point, index) => {
        const accent = index % 34 === 0;
        context.beginPath();
        context.arc(point.x, point.y, accent ? 1.7 : points[index].layer === 2 ? 1.05 : .6, 0, Math.PI * 2);
        context.fillStyle = accent ? 'rgba(125, 192, 238, .7)' : 'rgba(167, 172, 180, .5)';
        context.fill();
      });

      if (!reduced.matches) frame = requestAnimationFrame(draw);
    };

    const pointerMove = (event: PointerEvent) => {
      const box = root.getBoundingClientRect();
      pointer.x = (event.clientX - box.left) / box.width;
      pointer.y = (event.clientY - box.top) / box.height;
      pointer.active = true;
    };

    const pointerLeave = () => { pointer.active = false; };
    const onScroll = () => {
      const box = root.getBoundingClientRect();
      scroll.value = Math.max(-1, Math.min(1, -box.top / Math.max(1, box.height)));
    };
    const observer = new ResizeObserver(resize);
    observer.observe(root);
    root.addEventListener('pointermove', pointerMove);
    root.addEventListener('pointerleave', pointerLeave);
    window.addEventListener('scroll', onScroll, { passive: true });
    resize();
    draw();

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(frame);
      observer.disconnect();
      root.removeEventListener('pointermove', pointerMove);
      root.removeEventListener('pointerleave', pointerLeave);
      window.removeEventListener('scroll', onScroll);
    }, { once: true });
  };

  bootSignalField();
  document.addEventListener('astro:page-load', bootSignalField);
</script>
