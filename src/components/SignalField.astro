<div class="signal-field" data-signal-field aria-hidden="true">
  <canvas></canvas>
  <div class="signal-field__bloom"></div>
  <div class="signal-field__axis signal-field__axis--x"></div>
  <div class="signal-field__axis signal-field__axis--y"></div>
</div>

<script>
  type Point = { x: number; y: number; phase: number; speed: number; layer: number };

  const bootSignalField = () => {
    const root = document.querySelector<HTMLElement>('[data-signal-field]:not([data-ready])');
    if (!root) return;
    root.dataset.ready = 'true';

    const canvas = root.querySelector('canvas');
    const context = canvas?.getContext('2d');
    if (!canvas || !context) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const points: Point[] = Array.from({ length: 78 }, (_, index) => ({
      x: ((index * 47) % 101) / 101,
      y: ((index * 67) % 97) / 97,
      phase: index * 0.618,
      speed: 0.34 + ((index * 13) % 9) / 13,
      layer: index % 3,
    }));
    const pointer = { x: 0.52, y: 0.48, active: false };
    const scroll = { value: 0 };
    let frame = 0;
    let width = 0;
    let height = 0;
    let ratio = 1;

    const resize = () => {
      const box = root.getBoundingClientRect();
      ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, Math.floor(box.width));
      height = Math.max(1, Math.floor(box.height));
      canvas.width = Math.floor(width * ratio);
      canvas.height = Math.floor(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
    };

    const coordinates = (point: Point, time: number) => {
      const amplitude = 0.012 + point.layer * 0.009;
      const drift = reduced.matches ? 0 : Math.sin(time * point.speed + point.phase) * amplitude;
      const px = pointer.x - point.x;
      const py = pointer.y - point.y;
      const pd = Math.max(.05, Math.hypot(px, py));
      const pull = pointer.active && pd < .34 ? (0.34 - pd) * .11 : 0;
      return {
        x: Math.max(-0.02, Math.min(1.02, point.x + drift + (px / pd) * pull + scroll.value * (point.layer - 1) * .02)) * width,
        y: Math.max(-0.02, Math.min(1.02, point.y + Math.cos(time * point.speed * .71 + point.phase) * amplitude + (py / pd) * pull)) * height,
      };
    };

    const draw = (now = 0) => {
      const time = now / 2400;
      context.clearRect(0, 0, width, height);
      context.fillStyle = '#020307';
      context.fillRect(0, 0, width, height);

      const glow = context.createRadialGradient(
        (pointer.active ? pointer.x : .69) * width,
        (pointer.active ? pointer.y : .43) * height,
        0,
        (pointer.active ? pointer.x : .69) * width,
        (pointer.active ? pointer.y : .43) * height,
        Math.max(width, height) * .68,
      );
      glow.addColorStop(0, 'rgba(30, 238, 255, .105)');
      glow.addColorStop(.34, 'rgba(79, 52, 255, .055)');
      glow.addColorStop(1, 'rgba(0, 0, 0, 0)');
      context.fillStyle = glow;
      context.fillRect(0, 0, width, height);

      const mapped = points.map((point) => coordinates(point, time));
      for (let left = 0; left < mapped.length; left += 1) {
        for (let right = left + 1; right < mapped.length; right += 1) {
          const a = mapped[left];
          const b = mapped[right];
          const distance = Math.hypot(a.x - b.x, a.y - b.y);
          const threshold = Math.min(width, height) * (points[left].layer === points[right].layer ? .17 : .11);
          if (distance > threshold) continue;
          context.beginPath();
          context.moveTo(a.x, a.y);
          context.lineTo(b.x, b.y);
          const alpha = Math.max(.018, .13 - distance / 1400);
          const cyan = (left + right) % 7 !== 0;
          context.strokeStyle = cyan ? `rgba(96, 230, 255, ${alpha})` : `rgba(174, 96, 255, ${alpha * .75})`;
          context.lineWidth = points[left].layer === 0 ? .55 : 1;
          context.stroke();
        }
      }

      mapped.forEach((point, index) => {
        const accent = index % 13 === 0;
        context.beginPath();
        context.arc(point.x, point.y, accent ? 2.8 : points[index].layer === 2 ? 1.35 : .75, 0, Math.PI * 2);
        context.fillStyle = accent ? (index % 26 === 0 ? '#ff3ea5' : '#a6ff4d') : '#9defff';
        context.fill();
      });

      context.globalCompositeOperation = 'screen';
      context.lineWidth = 1;
      for (let band = 0; band < 4; band += 1) {
        context.beginPath();
        for (let x = -20; x <= width + 20; x += 12) {
          const y = height * (.2 + band * .18) + Math.sin(x * .006 + time * (.34 + band * .06) + band) * (22 + band * 8);
          x === -20 ? context.moveTo(x, y) : context.lineTo(x, y);
        }
        context.strokeStyle = band === 2 ? 'rgba(163, 69, 255, .13)' : 'rgba(57, 227, 255, .09)';
        context.stroke();
      }
      context.globalCompositeOperation = 'source-over';

      if (!reduced.matches) frame = requestAnimationFrame(draw);
    };

    const pointerMove = (event: PointerEvent) => {
      const box = root.getBoundingClientRect();
      pointer.x = (event.clientX - box.left) / box.width;
      pointer.y = (event.clientY - box.top) / box.height;
      pointer.active = true;
    };

    const pointerLeave = () => { pointer.active = false; };
    const onScroll = () => {
      const box = root.getBoundingClientRect();
      scroll.value = Math.max(-1, Math.min(1, -box.top / Math.max(1, box.height)));
    };
    const observer = new ResizeObserver(resize);
    observer.observe(root);
    root.addEventListener('pointermove', pointerMove);
    root.addEventListener('pointerleave', pointerLeave);
    window.addEventListener('scroll', onScroll, { passive: true });
    resize();
    draw();

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(frame);
      observer.disconnect();
      root.removeEventListener('pointermove', pointerMove);
      root.removeEventListener('pointerleave', pointerLeave);
      window.removeEventListener('scroll', onScroll);
    }, { once: true });
  };

  bootSignalField();
  document.addEventListener('astro:page-load', bootSignalField);
</script>
